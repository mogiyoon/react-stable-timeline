{
  "name": "@mogiyoon/react-stable-timeline",
  "version": "0.4.1",
  "description": "A React timeline with stable row packing — items never jump rows when you pan or zoom. Label-aware (Canvas2D) packing handles Hangul/Latin/mixed text correctly.",
  "license": "MIT",
  "author": "mogiyoon <mogiyoon@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mogiyoon/react-stable-timeline.git"
  },
  "homepage": "https://github.com/mogiyoon/react-stable-timeline#readme",
  "bugs": {
    "url": "https://github.com/mogiyoon/react-stable-timeline/issues"
  },
  "keywords": [
    "react",
    "timeline",
    "vis-timeline",
    "events",
    "chronology",
    "stable-stack",
    "korean",
    "hangul"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "esbuild demo/main.tsx --bundle --outfile=demo/bundle.js --servedir=demo --serve=0.0.0.0:5173 --jsx=automatic",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
